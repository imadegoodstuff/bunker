{
  "name": "bunker",
  "private": true,
  "version": "0.1.0",
  "description": "BUNKER: a Zcash-Sapling shielded pool and private launchpad on BNB Smart Chain. Groth16 proofs verified on-chain, relayer-paid fees, turnstile-bounded pools.",
  "license": "MIT",
  "workspaces": [
    "circuits",
    "contracts",
    "sdk",
    "legacy/sdk-v1",
    "legacy/indexer-v1",
    "relayer",
    "indexer",
    "agents",
    "app"
  ],
  "scripts": {
    "circuits:build": "npm -w circuits run build",
    "circuits:test": "npm -w circuits test",
    "sdk:build": "npm -w sdk run build",
    "sdk:test": "npm -w sdk test",
    "relayer:dev": "npm -w relayer run dev",
    "indexer:dev": "npm -w indexer run dev",
    "agents:dev": "npm -w agents run dev",
    "app:dev": "npm -w app run dev",
    "contracts:build": "npm -w contracts run build",
    "contracts:test": "npm -w contracts run test",
    "e2e": "node scripts/e2e.mjs --spawn",
    "test": "npm run contracts:test && npm run sdk:test && npm -w relayer test && npm -w indexer test && npm -w agents test",
    "audit": "node scripts/audit.mjs"
  },
  "overrides": {
    "ws": "^8.22.0",
    "underscore": "^1.13.8",
    "bfj": "^9.1.4",
    "elliptic": "^6.6.1",
    "postcss": "^8.5.30"
  },
  "engines": {
    "node": ">=22"
  }
}
