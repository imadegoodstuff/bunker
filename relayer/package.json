{
  "name": "@bunker/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fee-paying relayer for BUNKER: validates and simulates ShieldedPool.transact calls, pays gas, delays and shuffles submission.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/queue.test.js dist/fees.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@bunker/sdk": "*",
    "@bunker/sdk-v1": "*",
    "viem": "^2.38.0",
    "fastify": "^5.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
