{
  "name": "@scash/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scans scash vault events into SQLite and serves commitments, ciphertexts, nullifiers and roots to wallets.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --experimental-sqlite dist/index.js",
    "test": "tsc -p tsconfig.json && node --experimental-sqlite --test dist/scanner.test.js dist/meta.test.js",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "@scash/sdk": "*",
    "@solana/web3.js": "^1.98.4",
    "fastify": "^5.3.0",
    "@fastify/cors": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
