{
  "name": "@scash/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fee-paying relayer for scash: validates and simulates transact instructions, pays fees, delays and batches submission.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/queue.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@scash/sdk": "*",
    "@solana/web3.js": "^1.98.4",
    "fastify": "^5.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
